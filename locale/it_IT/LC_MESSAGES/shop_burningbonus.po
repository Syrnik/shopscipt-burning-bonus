msgid "Failed to determine the next write-off date"
msgstr "Impossibile determinare la data della prossima detrazione"

msgid "Unknown expiry schedule"
msgstr "Frequenza di scadenza sconosciuta"

msgid "Invalid write-off start date"
msgstr "Data di inizio delle detrazioni non valida"

msgid "Recipient address is not specified"
msgstr "Indirizzo del destinatario non indicato"

msgid "Notification has no message text"
msgstr "La notifica non ha un testo del messaggio"

