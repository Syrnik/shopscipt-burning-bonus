msgstr "Каждое {input} число месяца"

msgid "In months without day %d, the notification is sent on the last day of the month"
msgstr "В месяцах, где нет %d-го числа, уведомление уйдёт в последний день месяца"

msgid "Every Monday"
msgstr "По понедельникам"

